@page
@model Xsports.Pages.ConfiguracoesModel
@{
    ViewData["Title"] = "Configurações";
}

<div class="max-w-4xl mx-auto space-y-6">

    <!-- Cabeçalho da Página -->
    <div>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Configurações do Sistema</h1>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Gerencie as preferências gerais, aparência e informações do projeto.</p>
    </div>

    <!-- Alerta de Sucesso -->
    @if (TempData["MensagemSucesso"] != null)
    {
        <div class="p-4 text-sm text-green-800 dark:text-green-300 bg-green-50 dark:bg-green-900/30 rounded-xl border border-green-200 
        dark:border-green-800 shadow-sm flex items-center gap-2">
            <svg class="w-5 h-5 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>@TempData["MensagemSucesso"]</span>
        </div>
    }

    <form method="post" class="space-y-6">

        <!-- Informações Gerais da Loja -->
        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-6 shadow-sm space-y-4 transition-colors 
        duration-200">
            <div class="flex items-center gap-3 border-b border-gray-100 dark:border-gray-700 pb-4">
                <div class="p-2.5 bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 rounded-lg">
                    <i data-lucide="store" class="w-6 h-6"></i>
                </div>
                <div>
                    <h2 class="text-base font-semibold text-gray-900 dark:text-white">Dados do Projeto</h2>
                    <p class="text-xs text-gray-500 dark:text-gray-400">Informações sobre a loja e a equipe de desenvolvimento.</p>
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Nome da Loja</label>
                <input type="text" asp-for="NomeLoja" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 bg-white 
                dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg text-sm focus:ring-2 focus:ring-indigo-600 focus:outline-none" />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Desenvolvedores do Projeto</label>
                <textarea asp-for="Desenvolvedores" rows="6" readonly placeholder="Digite os nomes dos integrantes..." class="w-full px-4
                py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg text-sm 
                focus:ring-2 focus:ring-indigo-600 focus:outline-none"></textarea>
                <span class="text-xs text-gray-500 dark:text-gray-400 mt-1 block">Grupo do PIM.</span>
            </div>
        </div>

        <!-- Preferências do Sistema (Aparência e Alertas) -->
        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-6 shadow-sm space-y-6 
        transition-colors duration-200">
            <div class="flex items-center gap-3 border-b border-gray-100 dark:border-gray-700 pb-4">
                <div class="p-2.5 bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 rounded-lg">
                    <i data-lucide="sliders" class="w-6 h-6"></i>
                </div>
                <div>
                    <h2 class="text-base font-semibold text-gray-900 dark:text-white">Preferências do Sistema</h2>
                    <p class="text-xs text-gray-500 dark:text-gray-400">Ajuste o tema visual e as regras de avisos da aplicação.</p>
                </div>
            </div>

            <!-- Seleção de Tema Visual -->
            <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-3">Tema Visual</label>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    
                    <label id="lbl-claro" class="relative flex items-center justify-between p-4 border border-gray-200 dark:border-gray-700 
                    rounded-xl cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700/50 transition">
                        <div class="flex items-center gap-3">
                            <i data-lucide="sun" class="w-5 h-5 text-amber-500"></i>
                            <div>
                                <p class="text-sm font-medium text-gray-900 dark:text-white">Modo Claro</p>
                                <p class="text-xs text-gray-500 dark:text-gray-400">Padrão visual atual</p>
                            </div>
                        </div>
                        <input type="radio" name="Tema" value="claro" id="radio-claro" class="w-4 h-4 text-indigo-600 focus:ring-indigo-500" />
                    </label>

                    <label id="lbl-escuro" class="relative flex items-center justify-between p-4 border border-gray-200 dark:border-gray-700 
                    rounded-xl cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700/50 transition">
                        <div class="flex items-center gap-3">
                            <i data-lucide="moon" class="w-5 h-5 text-indigo-400"></i>
                            <div>
                                <p class="text-sm font-medium text-gray-900 dark:text-white">Modo Escuro</p>
                                <p class="text-xs text-gray-500 dark:text-gray-400">Interface em tons escuros</p>
                            </div>
                        </div>
                        <input type="radio" name="Tema" value="escuro" id="radio-escuro" class="w-4 h-4 text-indigo-600 focus:ring-indigo-500" />
                    </label>

                </div>
            </div>

            <hr class="border-gray-100 dark:border-gray-700" />

            <!-- Opções de Notificações / Alertas de Estoque -->
            <div class="space-y-4">
                <h3 class="text-sm font-semibold text-gray-800 dark:text-gray-200">Notificações e Alertas</h3>

                <div class="flex items-center justify-between py-2">
                    <div>
                        <p class="text-sm font-medium text-gray-800 dark:text-gray-200">Alertas de Estoque Baixo</p>
                        <p class="text-xs text-gray-500 dark:text-gray-400">Exibir aviso no menu superior quando um produto atingir a 
                        quantidade crítica.</p>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <!-- 'checkbox-alertas'-->
                        <input type="checkbox" id="checkbox-alertas" class="sr-only peer">
                        <div class="w-11 h-6 bg-gray-200 dark:bg-gray-700 peer-focus:outline-none rounded-full peer 
                        peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] 
                        after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full 
                        after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
                    </label>
                </div>

                <div class="flex items-center justify-between py-2 border-t border-gray-100 dark:border-gray-700">
                    <div>
                        <p class="text-sm font-medium text-gray-800 dark:text-gray-200">Notificação por E-mail</p>
                        <p class="text-xs text-gray-500 dark:text-gray-400">Enviar resumo diário de movimentações de produtos para o administrador.</p>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" class="sr-only peer">
                        <div class="w-11 h-6 bg-gray-200 dark:bg-gray-700 peer-focus:outline-none rounded-full peer 
                        peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] 
                        after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full 
                        after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
                    </label>
                </div>
            </div>
        </div>

        <!-- Botão Salvar -->
        <div class="flex justify-end">
            <button type="submit" class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-sm rounded-lg 
            shadow-sm transition flex items-center gap-2">
                <i data-lucide="save" class="w-4 h-4"></i>
                Salvar Informações
            </button>
        </div>

    </form>
</div>

<!-- Script do Modo Escuro, Alertas e Ícones -->
<script>
    lucide.createIcons();

    // Lógica do Tema Visual (Claro / Escuro)
    const radioClaro = document.getElementById('radio-claro');
    const radioEscuro = document.getElementById('radio-escuro');

    const temaSalvo = localStorage.getItem('tema') || 'claro';
    if (temaSalvo === 'escuro') {
        radioEscuro.checked = true;
    } else {
        radioClaro.checked = true;
    }

    function aplicarTema(tema) {
        if (tema === 'escuro') {
            document.documentElement.classList.add('dark');
            localStorage.setItem('tema', 'escuro');
        } else {
            document.documentElement.classList.remove('dark');
            localStorage.setItem('tema', 'claro');
        }
    }

    radioClaro.addEventListener('change', () => aplicarTema('claro'));
    radioEscuro.addEventListener('change', () => aplicarTema('escuro'));

    // Lógica de Alertas de Estoque Baixo (Salva preferência no navegador)
    const checkboxAlertas = document.getElementById('checkbox-alertas');
    
    // Por padrão vem ligado (true), a menos que o usuário tenha salvo como 'desligado'
    const alertasAtivados = localStorage.getItem('alertasEstoque') !== 'desligado';
    checkboxAlertas.checked = alertasAtivados;

    checkboxAlertas.addEventListener('change', () => {
        if (checkboxAlertas.checked) {
            localStorage.setItem('alertasEstoque', 'ligado');
        } else {
            localStorage.setItem('alertasEstoque', 'desligado');
        }
    });
</script>