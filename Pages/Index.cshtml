@page
@model IndexModel
@{
    ViewData["Title"] = "Catálogo de Produtos";
}

<!-- Cabeçalho da página -->
<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Catálogo de Produtos</h1>
    <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Visualize todos os itens disponíveis no catálogo.</p>
</div>

<!-- Filtro Categoria -->
<div class="flex items-center gap-2 mb-6 overflow-x-auto pb-2">
    <a href="/Index" class="px-4 py-2 rounded-lg text-sm font-medium transition border 
    @(string.IsNullOrEmpty(Model.Categoria) ? "bg-indigo-600 text-white border-indigo-600": 
    "bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700")">
        Todos
    </a>
    <a href="/Index?Categoria=Masculino" class="px-4 py-2 rounded-lg text-sm font-medium transition border 
    @(Model.Categoria == "Masculino" ? "bg-indigo-600 text-white border-indigo-600" : 
    "bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700")">
        Masculino
    </a>
    <a href="/Index?Categoria=Feminino" class="px-4 py-2 rounded-lg text-sm font-medium transition border 
    @(Model.Categoria == "Feminino" ? "bg-indigo-600 text-white border-indigo-600" : 
    "bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700")">
        Feminino
    </a>
    <a href="/Index?Categoria=Infantil" class="px-4 py-2 rounded-lg text-sm font-medium transition border 
    @(Model.Categoria == "Infantil" ? "bg-indigo-600 text-white border-indigo-600" : 
    "bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700")">
        Infantil
    </a>
    
</div>

@if (!string.IsNullOrEmpty(Model.TermoBusca))
{
    <div class="mb-6 p-3 bg-indigo-50 dark:bg-indigo-950/40 border border-indigo-200 dark:border-indigo-800 rounded-lg flex items-center 
    justify-between text-sm text-indigo-900 dark:text-indigo-200">
        <span>Resultados para a pesquisa: <strong>"@Model.TermoBusca"</strong></span>
        <a href="/Index" class="text-xs font-semibold underline hover:text-indigo-700 dark:hover:text-indigo-300">
            Limpar filtro
        </a>
    </div>
}

<!-- Grid Responsiva de Produtos -->
@if (Model.Produtos != null && Model.Produtos.Any())
{
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        @foreach (var item in Model.Produtos)
        {
            <div class="product-card bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden 
            hover:shadow-md transition flex flex-col justify-between">
                
                <!-- Fundo da Imagem -->
                <div class="h-48 bg-gray-50 dark:bg-gray-700/50 flex items-center justify-center p-4">
                    <img src="@item.ImagemUrl" alt="@item.Nome" class="max-h-full max-w-full object-contain rounded-lg" />
                </div>
                
                <div class="p-4 flex-1 flex flex-col justify-between">
                    <div>
                        <!-- Nome e Preço -->
                        <h3 class="product-name text-sm font-semibold text-gray-800 dark:text-gray-100 truncate" title="@item.Nome">@item.Nome</h3>
                        <p class="text-lg font-bold text-gray-900 dark:text-white mt-2">R$ @item.Preco.ToString("N2")</p>
                    </div>

                    <!-- Rodapé do Card -->
                    <div class="mt-4 flex items-center justify-between text-xs border-t border-gray-100 dark:border-gray-700 pt-3">
                        <span class="text-gray-500 dark:text-gray-400">
                            Estoque: <strong class="text-gray-700 dark:text-gray-200">@item.Estoque unid.</strong>
                        </span>
                        
                        <!-- Botões (Editar e Excluir) -->
                        <div class="flex items-center gap-3">
                            <a href="/Editar/@item.Id" class="text-indigo-600 dark:text-indigo-400 font-medium hover:underline">
                                Editar
                            </a>

                            <!-- Formulário para exclusão -->
                            <form method="post" asp-page-handler="Deletar" asp-route-id="@item.Id" onsubmit="
                            return confirm('Tem certeza que deseja excluir o produto @item.Nome?');">
                                <button type="submit" class="text-red-600 dark:text-red-400 font-medium hover:underline">
                                    Excluir
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-8 text-center text-gray-500 
    dark:text-gray-400">
        Nenhum produto encontrado no catálogo.
        @if (!string.IsNullOrEmpty(Model.TermoBusca))
        {
            <div class="mt-2">
                <a href="/Index" class="text-indigo-600 dark:text-indigo-400 font-medium hover:underline text-sm">
                    Limpar pesquisa
                </a>
            </div>
        }
    </div>
}