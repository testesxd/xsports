@page
@model MovimentacoesModel
@{
    ViewData["Title"] = "Saída de Produtos";
}

<div class="space-y-6">
    <!-- Cabeçalho -->
    <div>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Saída de Produtos</h1>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Registre baixas no estoque e acompanhe o histórico de movimentações.</p>
    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div class="p-4 rounded-lg bg-emerald-50 dark:bg-emerald-900/30 border border-emerald-200 dark:border-emerald-800 text-emerald-800 
        dark:text-emerald-200 text-sm flex items-center justify-between">
            <div class="flex items-center gap-2">
                <i data-lucide="check-circle" class="w-5 h-5 text-emerald-600 dark:text-emerald-400"></i>
                <span>@TempData["MensagemSucesso"]</span>
            </div>
            <button onclick="this.parentElement.remove()" class="text-emerald-600 dark:text-emerald-400 hover:opacity-75">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
    }

    <!-- Formulário de Registrar Saída -->
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-6 shadow-sm transition-colors duration-200">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
            <i data-lucide="minus-circle" class="w-5 h-5 text-indigo-600 dark:text-indigo-400"></i>
            Registrar Nova Saída
        </h2>

        <form method="post" class="space-y-4">
            <div asp-validation-summary="All" class="text-sm text-red-600 dark:text-red-400 font-medium"></div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <!-- Seleção do Produto -->
                <div class="md:col-span-1">
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Produto</label>
                    <select asp-for="NovaMovimentacao.ProdutoId" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 
                    rounded-lg text-sm bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-600 
                    focus:outline-none">
                        <option value="">Selecione um produto...</option>
                        @foreach (var prod in Model.ProdutosDisponiveis)
                        {
                            <option value="@prod.Id">@prod.Nome (Em estoque: @prod.Estoque)</option>
                        }
                    </select>

                    <p id="info-estoque" class="text-xs font-medium text-indigo-600 dark:text-indigo-400 mt-1.5 hidden flex items-center gap-1">
                        <i data-lucide="boxes" class="w-3.5 h-3.5"></i>
                        <span></span>
                    </p>
                </div>

                <!-- Quantidade -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Quantidade</label>
                    <input type="number" min="1" asp-for="NovaMovimentacao.Quantidade" required placeholder="1" class="w-full px-4 py-2 
                    border border-gray-300 dark:border-gray-600 rounded-lg text-sm bg-white dark:bg-gray-700 text-gray-900 dark:text-white 
                    focus:ring-2 focus:ring-indigo-600 focus:outline-none" />
                </div>

                <!-- Motivo -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Motivo</label>
                    <select asp-for="NovaMovimentacao.Motivo" required class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 
                    rounded-lg text-sm bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-600 
                    focus:outline-none">
                        <option value="Venda">Venda</option>
                        <option value="Avaria / Danificado">Danificado</option>
                        <option value="Perda / Extravio">Perda</option>
                        <option value="Uso Interno">Uso Interno</option>
                        <option value="Outro">Outro</option>
                    </select>
                </div>
            </div>

            <!-- Observação -->
            <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Observação (Opcional)</label>
                <input type="text" asp-for="NovaMovimentacao.Observacao" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 
                rounded-lg text-sm bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-indigo-600 
                focus:outline-none" />
            </div>

            <div class="flex justify-end pt-2">
                <button type="submit" class="px-5 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition 
                shadow-sm flex items-center gap-2">
                    <i data-lucide="check" class="w-4 h-4"></i>
                    Confirmar Saída
                </button>
            </div>
        </form>
    </div>

    <!-- Tabela de Histórico de Movimentações -->
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden shadow-sm transition-colors 
    duration-200">
        <div class="p-4 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between">
            <h3 class="font-semibold text-gray-900 dark:text-white">Histórico de Saídas</h3>
            <span class="text-xs text-gray-500 dark:text-gray-400">Total de registros: @Model.HistoricoMovimentacoes.Count</span>
        </div>

        @if (Model.HistoricoMovimentacoes.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-gray-600 dark:text-gray-300">
                    <thead class="bg-gray-50 dark:bg-gray-700/50 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                        <tr>
                            <th class="px-6 py-3">Data/Hora</th>
                            <th class="px-6 py-3">Produto</th>
                            <th class="px-6 py-3">Qtd Baixada</th>
                            <th class="px-6 py-3">Motivo</th>
                            <th class="px-6 py-3">Observação</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                        @foreach (var item in Model.HistoricoMovimentacoes)
                        {
                            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30 transition">
                                <td class="px-6 py-4 whitespace-nowrap text-xs text-gray-500 dark:text-gray-400">
                                    @item.DataMovimentacao.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="px-6 py-4 font-medium text-gray-900 dark:text-white">
                                    @(item.Produto?.Nome ?? "Produto Removido")
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap font-semibold text-red-600 dark:text-red-400">
                                    -@item.Quantidade unid.
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="px-2.5 py-1 text-xs font-medium rounded-full bg-gray-100 dark:bg-gray-700 text-gray-700 
                                    dark:text-gray-300">
                                        @item.Motivo
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-xs text-gray-500 dark:text-gray-400">
                                    @(string.IsNullOrEmpty(item.Observacao) ? "-" : item.Observacao)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-8 text-center text-gray-500 dark:text-gray-400 text-sm">
                Nenhuma movimentação de saída registrada até o momento.
            </div>
        }
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const selectProduto = document.getElementById('select-produto');
        const infoEstoque = document.getElementById('info-estoque');

        selectProduto?.addEventListener('change', function () {
            const opcaoSelecionada = this.options[this.selectedIndex];
            const estoque = opcaoSelecionada.getAttribute('data-estoque');

            if (estoque !== null && estoque !== "") {
                infoEstoque.querySelector('span').textContent = `Estoque disponível: ${estoque} unid.`;
                infoEstoque.classList.remove('hidden');
                if (typeof lucide !== 'undefined') lucide.createIcons();
            } else {
                infoEstoque.classList.add('hidden');
            }
        });
    });
</script>