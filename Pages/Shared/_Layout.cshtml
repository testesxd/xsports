@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @(Configuration["ConfiguracoesLoja:NomeLoja"] ?? "Xsports")</title>

    <!-- Modo Escuro -->
    <script>
        if (localStorage.getItem('tema') === 'escuro') {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                },
            },
        }
    </script>
</head>
<body class="bg-gray-50 dark:bg-gray-900 font-sans antialiased text-gray-800 dark:text-gray-100 transition-colors duration-200">

    @{
        var paginaAtualLayout = ViewContext.RouteData.Values["page"]?.ToString()?.ToLower();
        var ehTelaLogin = paginaAtualLayout == "/login";
    }

    <div class="flex h-screen overflow-hidden relative">
        
        @if (!ehTelaLogin)
        {
            <div id="sidebar-overlay" class="fixed inset-0 bg-black/50 z-20 hidden md:hidden"></div>

            <!-- Sidebar Responsiva -->
            <aside id="sidebar" class="fixed inset-y-0 left-0 z-30 w-64 bg-indigo-950 text-white flex flex-col justify-between 
            -translate-x-full md:translate-x-0 md:static transition-transform duration-300 ease-in-out shrink-0">
                <div>
                    <!-- Logo e Botão de Fechar -->
                    <div class="h-16 flex items-center justify-between px-6 border-b border-indigo-900/50">
                        <span class="text-xl font-bold tracking-wide text-white">
                            @(Configuration["ConfiguracoesLoja:NomeLoja"] ?? "Xsports")
                        </span>
                        <button id="close-sidebar" class="md:hidden text-indigo-200 hover:text-white">
                            <i data-lucide="x" class="w-6 h-6"></i>
                        </button>
                    </div>

                    <!-- Menu de Navegação -->
                    <nav class="p-4 space-y-1">
                        <a href="/Index" class="flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-indigo-200 
                        hover:bg-indigo-900/50 hover:text-white transition">
                            <i data-lucide="layout-grid" class="w-5 h-5"></i>
                            Home
                        </a>
                        <a href="/Estoque" class="flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-indigo-200 
                        hover:bg-indigo-900/50 hover:text-white transition">
                            <i data-lucide="boxes" class="w-5 h-5"></i>
                            Estoque
                        </a>
                        <a href="/Movimentacoes" class="flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-indigo-200 hover:bg-indigo-900/50 hover:text-white transition">
                            <i data-lucide="arrow-left-right" class="w-5 h-5"></i>
                            Saída de Produtos
                        </a>
                        <a href="/Alertas" class="flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-indigo-200 hover:bg-indigo-900/50 hover:text-white transition">
                            <i data-lucide="bell" class="w-5 h-5"></i>
                            Alertas
                        </a>
                    </nav>
                </div>

                <!-- Perfil do usuário no Rodapé do menu -->
                <div class="p-4 border-t border-indigo-900/50 flex items-center justify-between">
                    <a href="/Perfil" class="flex items-center gap-3 hover:opacity-80 transition group" title="Editar Perfil">
                        <!-- Avatar -->
                        <div id="sidebar-avatar-iniciais" class="w-9 h-9 rounded-full bg-indigo-700 flex items-center justify-center font-bold text-sm text-white">
                        </div>
                        <!-- Nome + Administrador -->
                        <div>
                            <p id="sidebar-nome-usuario" class="text-sm font-medium text-white group-hover:underline"></p>
                            <p class="text-xs text-indigo-300">Administrador</p>
                        </div>
                    </a>
                    <!-- Botão de Sair -->
                    <form method="post" asp-page="/Login" asp-page-handler="Logout">
                        <button type="submit" class="text-indigo-300 hover:text-white transition p-1" title="Sair do sistema" aria-label="Sair do sistema">
                            <i data-lucide="log-out" class="w-5 h-5"></i>
                        </button>
                    </form>
                </div>
            </aside>
        }

        <!-- Conteúdo Principal -->
        <div class="flex-1 flex flex-col overflow-y-auto w-full">
            
            @if (!ehTelaLogin)
            {
                <!-- Header Superior -->
                <header class="h-16 bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between px-4 md:px-6 sticky top-0 z-10 transition-colors duration-200">
                    <div class="flex items-center gap-3 w-full md:w-1/3">
                        <button id="open-sidebar" class="p-2 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg md:hidden">
                            <i data-lucide="menu" class="w-6 h-6"></i>
                        </button>
                        <!-- Páginas que não possuem a Barra de Pesquisa -->
                        @{
                            var paginaAtual = ViewContext.RouteData.Values["page"]?.ToString();
                            var paginasSemBusca = new[] { "/Cadastrar", "/Configuracoes", "/Movimentacoes", "/Perfil", "/Alertas" };
                        }
                        <!-- Pesquisa -->
                        @if (!paginasSemBusca.Contains(paginaAtual))
                        {
                            var termoAtual = Context.Request.Query["TermoBusca"].ToString();

                            <form method="get" class="relative w-full">
                                <i data-lucide="search" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
                                <input 
                                    id="search-input" 
                                    type="text" 
                                    name="TermoBusca" 
                                    value="@termoAtual"
                                    placeholder="Buscar..." 
                                    class="w-full pl-9 pr-8 py-2 bg-gray-100 dark:bg-gray-700 dark:text-white border-none rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-600" 
                                />
                                @if (!string.IsNullOrEmpty(termoAtual))
                                {
                                    <a href="@Context.Request.Path" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200" title="Limpar busca">
                                        <i data-lucide="x" class="w-4 h-4"></i>
                                    </a>
                                }
                            </form>
                        }
                    </div>

                    <div class="flex items-center gap-3">
                        <a href="/Alertas" class="p-2 text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition" title="Alertas">
                            <i data-lucide="bell" class="w-5 h-5"></i>
                        </a>
                        
                        <a href="/Configuracoes" class="p-2 text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition" title="Configurações">
                            <i data-lucide="settings" class="w-5 h-5"></i>
                        </a>
                    </div>
                </header>
            }

            <!-- Renderização do Conteúdo das Páginas -->
            <main class="@(ehTelaLogin ? "p-0 h-full" : "p-6")">
                @RenderBody()
            </main>
        </div>

    </div>

    <script>
        lucide.createIcons();

        // Lógica do Menu Lateral 
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebar-overlay');
        const openBtn = document.getElementById('open-sidebar');
        const closeBtn = document.getElementById('close-sidebar');

        function openMenu() {
            sidebar?.classList.remove('-translate-x-full');
            overlay?.classList.remove('hidden');
        }

        function closeMenu() {
            sidebar?.classList.add('-translate-x-full');
            overlay?.classList.add('hidden');
        }

        openBtn?.addEventListener('click', openMenu);
        closeBtn?.addEventListener('click', closeMenu);
        overlay?.addEventListener('click', closeMenu);
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const statusAlertas = localStorage.getItem('alertasEstoque');
            if (statusAlertas === 'desligado') {
                return; 
            }

            fetch('/Estoque?handler=Notificacoes')
                .then(response => response.json())
                .then(data => {
                    if (data.total > 0) {
                        const iconeSino = document.querySelector('header a[href="/Alertas"]');
                        if (iconeSino) {
                            let badgeSino = iconeSino.querySelector('.badge-alerta');
                            if (!badgeSino) {
                                badgeSino = document.createElement('span');
                                badgeSino.className = 'badge-alerta';
                                badgeSino.style.backgroundColor = '#ef4444';
                                badgeSino.style.borderRadius = '9999px';
                                badgeSino.style.width = '8px';
                                badgeSino.style.height = '8px';
                                badgeSino.style.position = 'absolute';
                                badgeSino.style.top = '10px';
                                badgeSino.style.right = '10px';
                            
                                iconeSino.style.position = 'relative';
                                iconeSino.appendChild(badgeSino);
                            }
                        }

                        const linkMenuAlertas = document.querySelector('aside nav a[href="/Alertas"]');
                        if (linkMenuAlertas) {
                            const badgeAntigo = linkMenuAlertas.querySelector('.badge-alerta-menu');
                            if (badgeAntigo) {
                                badgeAntigo.remove();
                            }

                            const badgeMenu = document.createElement('span');
                            badgeMenu.className = 'badge-alerta-menu';
                            badgeMenu.style.backgroundColor = '#ef4444';
                            badgeMenu.style.color = 'white';
                            badgeMenu.style.borderRadius = '9999px';
                            badgeMenu.style.padding = '2px 8px';
                            badgeMenu.style.fontSize = '11px';
                            badgeMenu.style.fontWeight = 'bold';
                            badgeMenu.style.marginLeft = 'auto';
                        
                            linkMenuAlertas.style.display = 'flex';
                            linkMenuAlertas.style.alignItems = 'center';
                            linkMenuAlertas.appendChild(badgeMenu);
                            badgeMenu.innerText = data.total;
                        }
                    }
                })
            .catch(error => console.error('Erro ao buscar notificações globais:', error));
        });
    </script>
    <!-- Carrega o nome e iniciais salvos no Perfil ao abrir qualquer página -->
    <script>
    
        document.addEventListener("DOMContentLoaded", function() {
            const nomeSalvo = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(User.Identity?.Name ?? ""));
            if (nomeSalvo) {
                const spanNomeSidebar = document.getElementById('sidebar-nome-usuario');
                const avatarIniciais = document.getElementById('sidebar-avatar-iniciais');
            
                if (spanNomeSidebar) spanNomeSidebar.innerText = nomeSalvo;
                if (avatarIniciais && nomeSalvo.length >= 2) {
                    avatarIniciais.innerText = nomeSalvo.substring(0, 2).toUpperCase();
                }
            }
        });
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll("form[data-submit-cooldown]").forEach(function (form) {
                const button = form.querySelector('button[type="submit"], input[type="submit"]');
                if (!button) return;

                const cooldownSeconds = 5;
                const storageKey = `submitCooldown:${form.dataset.submitCooldown}`;
                const originalContent = button.innerHTML;
                let countdownTimer;

                function updateButton() {
                    const expiresAt = Number(sessionStorage.getItem(storageKey) || 0);
                    const remaining = Math.ceil((expiresAt - Date.now()) / 1000);

                    if (remaining <= 0) {
                        sessionStorage.removeItem(storageKey);
                        button.disabled = false;
                        button.innerHTML = originalContent;
                        button.classList.remove("opacity-60", "cursor-not-allowed");
                        if (countdownTimer) clearInterval(countdownTimer);
                        return;
                    }

                    button.disabled = true;
                    button.textContent = `Aguarde ${remaining}s`;
                    button.classList.add("opacity-60", "cursor-not-allowed");
                    if (!countdownTimer) countdownTimer = setInterval(updateButton, 250);
                }

                form.addEventListener("submit", function (event) {
                    const expiresAt = Number(sessionStorage.getItem(storageKey) || 0);
                    if (expiresAt > Date.now()) {
                        event.preventDefault();
                        updateButton();
                        return;
                    }

                    sessionStorage.setItem(storageKey, String(Date.now() + cooldownSeconds * 1000));
                    updateButton();
                });

                updateButton();
            });
        });
    </script>
    
</body>
</html>